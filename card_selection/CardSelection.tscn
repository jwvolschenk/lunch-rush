[gd_scene format=3]

[sub_resource type="StyleBoxFlat" id="card_style"]
bg_color = Color( 0.15, 0.15, 0.15, 1 )
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color( 0.4, 0.4, 0.4, 1 )
cornerRadius = 6

[sub_resource type="StyleBoxFlat" id="panel_style"]
bg_color = Color( 0.08, 0.08, 0.08, 0.92 )
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color( 0.25, 0.25, 0.25, 1 )

[sub_resource type="Theme" id="card_theme"]
fonts/normal_font_size = 16
colors/font_color = Color( 0.95, 0.95, 0.95, 1 )

[sub_resource type="ColorRect" id="overlay_bg"]
color = Color( 0, 0, 0, 0.55 )

[sub_resource type="ColorRect" id="card_icon"]

[node name="CardSelection" type="Control" id="1"]
layout_mode = 1
anchors_preset = 7
anchor_right = 1
anchor_bottom = 1
